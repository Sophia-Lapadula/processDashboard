# Supabase (org ypfgdqzcuelpgcumbbbd — pessoal/Odyssey)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# AES-GCM key for conector secrets (32 bytes, base64-encoded)
# Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Webhook HMAC secrets are stored per-trigger in DB.
# This is the global signing secret used for cron dispatch + workflow callbacks.
PLATFORM_SIGNING_SECRET=

# Secret usado pra autenticar invocações do Vercel Cron.
# Configure no Vercel: Settings > Environment Variables como CRON_SECRET.
# Em local dev, deixe vazio e use PLATFORM_SIGNING_SECRET pra testar manualmente.
CRON_SECRET=

# Public URL (used for webhook callbacks, slack messages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
